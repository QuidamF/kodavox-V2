# Entorno KodaVox V2
# Selecciona el proveedor LLM: ollama, openai o gemini
LLM_PROVIDER=ollama

# Configuración Ollama (local)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Configuración OpenAI (requiere API key)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Configuración Google Gemini (requiere API key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
# Speech-to-text: medium mejora precisión en español a costa de más VRAM y latencia.
STT_MODEL=medium
STT_BEAM_SIZE=5
# Solo términos propios; evita sesgar la transcripción con frases genéricas.
STT_INITIAL_PROMPT="KodaVox, NextBeam"
STT_VAD_FILTER=true
STT_CONDITION_ON_PREVIOUS_TEXT=false
# active responde a cualquier frase válida; wakeword exige la frase de activación.
INTERACTION_MODE=wakeword
WAKE_WORD=KodaVox
# VAD más estricto para descartar ruido, frases cortas y pausas internas.
VAD_THRESHOLD=0.60
VAD_END_SILENCE_SECONDS=0.40
STT_MIN_SPEECH_SECONDS=0.90
VAD_PRE_PADDING_SECONDS=0.20
# Tras la respuesta, conserva el contexto conversacional este número de segundos.
WAKE_SESSION_TIMEOUT_SECONDS=10
# Selecciona el proveedor: xtts, piper u off.
TTS_PROVIDER=piper
# Ajustes de Piper: >1.0 ralentiza la voz; <1.0 la acelera.
PIPER_MODEL_PATH=models/es_MX-claude-high.onnx
PIPER_LENGTH_SCALE=.85
PIPER_NOISE_SCALE=0.75
# TTS conserva la voz configurada en su base de datos y reutiliza sus latentes.
# Para cambiarla al arrancar, define ambas variables explícitamente:
# TTS_CONFIGURE_VOICE_ON_START=true
# VOICE_SAMPLE=Karla.wav
